{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    /* Path mapping */
    "baseUrl": ".",
    "paths": {
      "@/*": ["./frontend/health-nexus-solution/src/*"]
    }
  },
  "include": [
    "frontend/health-nexus-solution/src/**/*",
    "frontend/health-nexus-solution/**/*.ts",
    "frontend/health-nexus-solution/**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "capstone/**/*"
  ]
}