# LunaSync Environment Configuration Template
# Copy this file to .env.production and fill in your actual values

# Environment Settings
DEBUG=False
PRODUCTION=True
SECRET_KEY=your-super-secret-production-key-here-generate-a-new-one

# Database Configuration (required for production)
DATABASE_URL=postgresql://user:password@host:port/database

# Security Settings (required for production)
ALLOWED_HOSTS=lunasync.site,www.lunasync.site
CORS_ALLOWED_ORIGINS=https://lunasync.site,https://www.lunasync.site
CSRF_TRUSTED_ORIGINS=https://lunasync.site,https://www.lunasync.site

# Encryption key for AES-256 (must be 32 bytes, base64-encoded)
ENCRYPTION_KEY=your-base64-encoded-32-byte-key

# Default Superadmin Account (change these after deployment)
SUPERADMIN_EMAIL=admin@lunasync.site
SUPERADMIN_PASSWORD=your-secure-password-here

# iProg SMS API Configuration
IPROG_API_TOKEN=your-production-iprog-token
IPROG_API_URL=https://sms.iprogtech.com/api/v1/sms_messages
IPROG_SMS_PROVIDER=0

# Gmail Configuration for Email Notifications
EMAIL_PASSWORD=your-production-email-password

# AWS Textract Configuration for OCR Processing
AWS_ACCESS_KEY_ID=your-production-aws-access-key
AWS_SECRET_ACCESS_KEY=your-production-aws-secret-key
AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1