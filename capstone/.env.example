# iProg SMS API Configuration
# Add these to your .env file for iProg SMS integration

# iProg SMS API Settings
IPROG_API_KEY=your_iprog_api_key_here
IPROG_SENDER_ID=MedSync
IPROG_API_URL=https://api.iprog.com.ph/api/send
IPROG_BALANCE_URL=https://api.iprog.com.ph/api/balance

# Backup Twilio Settings (Optional)
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=your_twilio_phone_number_here
