<!DOCTYPE html>
    <html>
    <head>
      <title>Lab Result Report - Ana Betz</title>
      <meta charset="UTF-8">
      <style>
        * {
          margin: 0;
          padding: 0;
          box-sizing: border-box;
        }
        
        body { 
          font-family: 'Times New Roman', serif; 
          font-size: 11pt;
          line-height: 1.4;
          background-color: #ffffff;
          color: #000000;
          width: 8.5in;
          min-height: 11in;
          margin: 0 auto;
          padding: 0.5in;
        }
        
        .page {
          width: 100%;
          min-height: 10in;
          background: white;
          padding: 0.4in;
          display: flex;
          flex-direction: column;
        }
        
        .header {
          text-align: center;
          border-bottom: 2px solid #000;
          padding-bottom: 10px;
          margin-bottom: 15px;
        }
        
        .title {
          font-size: 16pt;
          font-weight: bold;
          color: #000;
          margin-bottom: 5px;
        }
        
        .date {
          font-size: 9pt;
          color: #555;
        }
        
        .info-section {
          border: 1px solid #ccc;
          padding: 12px;
          margin-bottom: 15px;
          background: #f9f9f9;
        }
        
        .info-grid {
          display: grid;
          grid-template-columns: 1fr 1fr;
          gap: 8px;
          font-size: 10pt;
        }
        
        .info-item {
          margin: 3px 0;
        }
        
        .label {
          font-weight: bold;
          color: #000;
          display: inline-block;
          width: 90px;
        }
        
        .results-header {
          font-size: 12pt;
          font-weight: bold;
          color: #000;
          margin: 8px 0 8px 0;
          border-bottom: 1px solid #ccc;
          padding-bottom: 4px;
        }
        
        .content {
          white-space: pre-wrap;
          font-family: 'Courier New', monospace;
          font-size: 9pt;
          line-height: 1.3;
          border: 1px solid #ddd;
          padding: 12px;
          background: #fdfdfd;
          word-break: break-word;
          overflow-wrap: break-word;
          flex: 1;
        }
        
        /* Print styles for PDF generation */
        @media print {
          body {
            width: 8.5in;
            height: 11in;
            margin: 0;
            padding: 0.4in;
            font-size: 9pt;
          }
          
          .page {
            box-shadow: none;
            margin: 0;
            padding: 0.2in;
            height: 10.2in;
            min-height: 10.2in;
          }
          
          .header {
            padding-bottom: 5px;
            margin-bottom: 8px;
          }
          
          .title {
            font-size: 12pt;
          }
          
          .info-section {
            padding: 6px;
            margin-bottom: 8px;
          }
          
          .info-grid {
            font-size: 8pt;
          }
          
          .results-header {
            font-size: 10pt;
            margin: 5px 0 5px 0;
          }
          
          .content {
            border: 1px solid #000;
            font-size: 7pt;
            line-height: 1.1;
            padding: 6px;
            overflow: hidden;
            flex: 1;
            max-height: none;
          }
        }
      </style>
    </head>
    <body>
